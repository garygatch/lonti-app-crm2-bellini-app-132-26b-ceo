      "body": "const actionMap = {\n    \"ADD\": \"plus\",\n    \"EDIT\": \"edit\",\n    \"UPLOAD\": \"upload\",\n    \"EXPORT\": \"download\",\n    \"LINK\": \"link\",\n    \"UNLINK\": \"unlink\",\n    \"ASSIGN\": \"plus\",\n    \"UNASSIGN\": \"times\"\n};\n\nswitch (true) {\n    case actionMap[$ctrl.action] !== undefined:\n        return actionMap[$ctrl.action];\n    case $ctrl.action?.includes(\"EXPORT\"):\n        return \"download\";\n    case $ctrl.action?.includes(\"LINK\"):\n        return \"link\";\n    default:\n        return \"question\";\n}",
