        },
        {
          "expression": "$ctrl.currentFormTabName",
          "to": "currentFormTabName"
        },
        {
          "expression": "[\n    {\n        label: $ctrl.currentFormTabName,\n        onClick: \"function\",\n        function: () => {\n            const lowerCasedCurrentFormTabName = $ctrl.currentFormTabName.toLowerCase();\n            if (lowerCasedCurrentFormTabName === \"general\") {\n                $ctrl.currentPipelineValue = undefined;\n            }\n            $ctrl.utilityService.clearForm($ctrl.opportunityForm[lowerCasedCurrentFormTabName]);\n        }\n    },\n    {\n        label: \"All\",\n        onClick: \"function\",\n        function: () => {\n            $ctrl.currentPipelineValue = undefined;\n            $ctrl.utilityService.clearForm($ctrl.opportunityForm);\n        }\n    }\n]",
          "to": "resetItems"
        },
        {
          "expression": "$ctrl.backButtonOnClick()",
          "to": "backButtonOnClick"
        },
        {
          "expression": "$ctrl.backButtonDisabled",
          "to": "backButtonDisabled"
        },
        {
          "expression": "$ctrl.isLoading",
          "to": "backButtonLoading"
        }
