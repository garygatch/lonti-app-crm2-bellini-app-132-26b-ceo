      "body": "const requestedOpportunityId = $ctrl.opportunityId;\n\nif (!$ctrl.isAdmin && !$ctrl.hasPipelineRole) return;\n$ctrl.pipelineValues = [];\n\ntry {\n  const { entities: fetchedPipelines } = await $ctrl.pipelineService.getAllPipelines(page, limit, query, clearCache);\n\n  if (requestedOpportunityId !== $ctrl.opportunityId) {\n    return;\n  }\n\n  if (fetchedPipelines && fetchedPipelines.length > 0) {\n    $ctrl.pipelineValues = fetchedPipelines.map(pipeline => ({\n      label: pipeline.name,\n      value: pipeline.pipelineId\n    }));\n\n    const currentPipelineStageId = $ctrl.opportunityForm.general.pipelineStageId;\n    if (currentPipelineStageId) {\n      const pipelineStages = $ctrl.pipelineStageService.getCachedPipelineStages()\n      const pipelineStage = pipelineStages.find(pipelineStage => pipelineStage.pipelineStageId === currentPipelineStageId);\n      $ctrl.currentPipelineValue = pipelineStage.pipelineId;\n    }\n\n  } else {\n    $ctrl.pipelineValues = [];\n    console.warn(\"Pipeline service returned no data or an empty array.\");\n  }\n\n} catch (error) {\n  console.error(\"Error fetching pipelines:\", error);\n  $ctrl.utilityService.toast(\"Failed to load pipelines. Please try again.\", \"ERROR\");\n  $ctrl.pipelineValues = [];\n}",
      "description": "",
      "invokeOnLoad": true,
      "isAsync": true,
      "name": "onInit",
      "parameters": [
        "page",
        "limit",
        "query",
        "clearCache"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "const tabNameLookup = {\n    1: \"General\",\n    2: \"Finance\",\n    3: \"Timeline\",\n    4: \"Engagement\"\n}\n\n$ctrl.currentFormTabName = tabNameLookup[$ctrl.currentFormTab];",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "watchCurrentFormTab",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
