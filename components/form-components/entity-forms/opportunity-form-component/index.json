      ]
    },
    {
      "id": "service",
      "name": "utilityService",
      "resourceIdentity": "services/util-services/utility-service",
      "type": "service"
    },
    {
      "id": "service",
      "name": "pipelineService",
      "resourceIdentity": "services/entity-services/entity-specific-services/pipeline-service",
