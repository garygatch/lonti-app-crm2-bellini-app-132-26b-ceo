    {
      "id": "service",
      "name": "pipelineStageService",
      "resourceIdentity": "services/entity-services/entity-specific-services/pipeline-stage-service",
      "type": "service"
    },
    {
      "body": "if (!$ctrl.currentPipelineValue) {\n    $ctrl.pipelineStageValues = [];\n    return;\n}\n\nconst storedPipelineStage = $ctrl.opportunityForm.general.pipelineStageId;\nconst requestedPipelineValue = $ctrl.currentPipelineValue;\n\n$ctrl.pipelineStageValues = [];\n$ctrl.opportunityForm.general.pipelineStageId = undefined;\n\ntry {\n    const { entities: fetchedStages } = await $ctrl.pipelineStageService.getAllPipelineStagesByPipelineId(\n        undefined,\n        undefined,\n        undefined,\n        undefined,\n        requestedPipelineValue\n    );\n\n    if ($ctrl.currentPipelineValue !== requestedPipelineValue) {\n        return;\n    }\n\n    if (fetchedStages && fetchedStages.length > 0) {\n        const originalPipelineStage = fetchedStages.find(pipelineStage => pipelineStage.pipelineStageId === storedPipelineStage);\n\n        if (originalPipelineStage) {\n            $ctrl.opportunityForm.general.pipelineStageId = storedPipelineStage;\n        }\n\n        $ctrl.pipelineStageValues = fetchedStages.map(pipelineStage => ({\n            label: pipelineStage.name,\n            value: pipelineStage.pipelineStageId\n        }));\n    } else {\n        $ctrl.pipelineStageValues = [];\n        console.warn(`No stages found for pipeline ID: ${$ctrl.currentPipelineValue}`);\n    }\n    \n} catch (error) {\n    console.error(`Error loading stages for pipeline ID: ${$ctrl.currentPipelineValue}`, error);\n    $ctrl.utilityService.toast(`Failed to load stages for selected Pipeline. Please try again.`, \"ERROR\");\n    $ctrl.pipelineStageValues = [];\n}",
