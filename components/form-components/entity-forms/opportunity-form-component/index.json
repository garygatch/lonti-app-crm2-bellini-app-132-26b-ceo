        {
          "expression": "[\n    {\n        label: \"General\",\n        closable: false\n    },\n    {\n        label: \"Finance\",\n        closable: false\n    },\n    {\n        label: \"Timeline\",\n        closable: false\n    },\n    {\n        label: \"Engagement\",\n        closable: false\n    }\n]",
