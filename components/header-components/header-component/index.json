    {
      "name": "$cookies",
      "type": "service"
    },
    {
      "body": "try {\n    await $ctrl.authService.setSaasAuth();\n\n    $ctrl.authService.currentTenantCode = $ctrl.$cookies.get(\"x_tenant_code\");\n    $ctrl.authService.currentTenantName = $ctrl.$cookies.get(\"x_tenant_name\") ?? \"NONE\";\n\n    if (!$ctrl.authService.currentTenantCode) {\n        await $ctrl.onOpenTenantSelectionModal();\n        $ctrl.loadData();\n    } else {\n        $ctrl.loadData();\n    }\n\n} catch (error) {\n    console.error(\"Failed to initialize header component due to an authentication error:\", error);\n}",
