      },
      "type": "method",
      "watch": []
    },
    {
      "body": "try {\n    $ctrl.selectedEventDetails = {};\n\n    const stateObj = selectedEvent?.raw;\n    if (!stateObj || !stateObj.trackerDocumentStateContent) {\n        return;\n    }\n\n    const contentData = stateObj.trackerDocumentStateContent;\n    let rawPayload = null;\n\n    if (contentData.modelContent && contentData.modelContent.content) {\n        rawPayload = contentData.modelContent.content;\n    }\n    else if (contentData.content) {\n        try {\n            const decoded = atob(contentData.content);\n            const parsed = JSON.parse(decoded);\n            rawPayload = parsed.content || parsed;\n        } catch (e) {\n            rawPayload = contentData.content;\n        }\n    }\n    else if (contentData.stringContent) {\n        rawPayload = contentData.stringContent;\n    }\n\n    if (rawPayload) {\n        if (typeof $ctrl.onTabChange === 'function') {\n            const activityDetailsTabPosition = $ctrl.tabItems.findIndex((tab) => tab.label === \"Activity Details\") + 1;\n            $ctrl.currentTabIndex = activityDetailsTabPosition;\n            $ctrl.onTabChange(activityDetailsTabPosition);\n        }\n\n        $ctrl.selectedEventDetails = $ctrl.utilityService.formatEntityForDisplay(rawPayload);\n    }\n\n} catch (e) {\n    console.error(\"Error setting selected event details.\", e);\n    $ctrl.selectedEventDetails = {};\n}",
      "description": "",
