    },
    {
      "body": "if ($ctrl.currentInfoPanelTab !== \"Calls\") {\n    $ctrl.currentTabIndex = $ctrl.tabItems.findIndex(tab => tab.label === \"Calls\");\n    const tabToSelect = $ctrl.currentTabIndex + 1;\n    $ctrl.onTabChange(tabToSelect);\n    $ctrl.currentTabIndex += 1;\n    $ctrl.isAddingCall = true;\n    return;\n}\n\n$ctrl.isAddingCall = !$ctrl.isAddingCall;",
      "description": "",
