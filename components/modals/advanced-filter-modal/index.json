  "type": "custom-component",
  "variables": [
    {
      "body": "try {\n    if ($ctrl.filtersApplied && $ctrl.filtersApplied.length) {\n        $ctrl.filtersApplied.forEach(filter => {\n            if (filter.property === 'pipelineStageId' || filter.property === 'pipelineId') {\n                filter.operation = 'eq';\n            }\n        });\n    }\n\n    const populatedFilters = $ctrl.utilityService.getValidFilters($ctrl.filtersApplied || []);\n    const populatedSorts = ($ctrl.sortsApplied || []).filter(sort => sort && sort.value);\n\n    $ctrl.filtersAppliedCount = populatedFilters.length;\n    $ctrl.sortsAppliedCount = populatedSorts.length;\n\n    $ctrl.filterQueryString = populatedFilters\n        .map(filter => $ctrl.utilityService.buildFilterQuery(filter))\n        .join('&');\n\n    $ctrl.sortQueryString = populatedSorts\n        .map(sort => {\n            const order = sort.order || 'ASC';\n            return `${sort.value}:${order}`;\n        })\n        .join(',');\n\n    $ctrl.result = \"applied\";\n    $ctrl.onClose();\n\n} catch (error) {\n    console.error('Error processing filter logic:', error);\n    $ctrl.filtersAppliedCount = 0;\n    $ctrl.result = null;\n}",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onShowResultsButtonClick",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.result = null;\n$ctrl.onClose();",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onCancelButtonClick",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
