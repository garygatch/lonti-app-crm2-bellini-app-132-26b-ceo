    {
      "id": "service",
      "name": "enService",
      "resourceIdentity": "services/i18n-services/en-service",
      "type": "service"
    },
    {
      "description": "",
      "name": "buttonHandlers",
      "properties": [
        {
          "body": "const checkedColumns = $ctrl.columns.filter((c) => c.checked).map((c) => c.label);\n\n$ctrl.quickSearchConfigService.saveConfig($ctrl.currentPageKey, $ctrl.quickSearchConfig.property, $ctrl.quickSearchConfig.operation);\nif ($ctrl.resetConfig && $ctrl.quickSearchConfig.property === $ctrl.defaultConfig.property && $ctrl.quickSearchConfig.operation === $ctrl.defaultConfig.operation) {\n    $ctrl.quickSearchConfigService.clearConfig($ctrl.currentPageKey);\n    $ctrl.quickSearchConfigService.saveConfig($ctrl.currentPageKey, $ctrl.defaultConfig.property, $ctrl.defaultConfig.operation);\n}\n\nif ($ctrl.resetConfig && $ctrl.columnConfig.checkedColumnCount === $ctrl.defaultConfig.columns.length && $ctrl.columns.filter((c) => c.checked).every((c) => $ctrl.defaultConfig.columns.includes(c.label))) {\n    $ctrl.columnConfigService.clearConfig($ctrl.currentPageKey);\n} else if (checkedColumns.length > 0) {\n    $ctrl.columnConfigService.saveConfig($ctrl.currentPageKey, checkedColumns);\n}\n\n$ctrl.result = \"saved\";\n$ctrl.onClose();",
          "description": "This function is called when OK button is clicked.",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onSaveButtonClick",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "$ctrl.resetConfig = true;\n$ctrl.quickSearchConfig.property = $ctrl.defaultConfig.property;\n$ctrl.quickSearchConfig.operation = $ctrl.defaultConfig.operation;\n$ctrl.columns.forEach((c) => c.checked = $ctrl.defaultConfig.columns.includes(c.label));\n$ctrl.onComponentInit();",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onRestoreDefaultsButtonClick",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "$ctrl.onClose()",
          "description": "This function is called when Cancel button is clicked.",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onCancelClick",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        }
      ],
      "type": "object"
    },
    {
      "description": "",
      "name": "quickSearchConfig",
      "properties": [
        {
          "description": "",
          "name": "property",
          "type": "property",
          "value": ""
        },
        {
          "description": "",
          "name": "operation",
          "type": "property",
          "value": ""
        }
      ],
      "type": "object"
    },
    {
      "description": "",
      "name": "columnConfig",
      "properties": [
        {
          "description": "",
          "name": "checkedColumnCount",
          "type": "property",
          "value": ""
        },
        {
          "body": "$ctrl.columnConfig.checkedColumnCount = $ctrl.columns?.filter((c) => c.checked).length ?? 0;",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onColumnCheckedChange",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        }
      ],
      "type": "object"
    },
    {
      "body": "const savedQuickSearchConfig = $ctrl.quickSearchConfigService.getConfig($ctrl.currentPageKey);\nconst savedColumnConfig = $ctrl.columnConfigService.getConfig($ctrl.currentPageKey, $ctrl.defaultConfig?.columns);\nconst savedColumns = Array.isArray(savedColumnConfig) ? savedColumnConfig : savedColumnConfig?.columnNames;\n\n$ctrl.quickSearchConfig.property = $ctrl.quickSearchConfig.property ?? savedQuickSearchConfig?.property;\n$ctrl.quickSearchConfig.operation = $ctrl.quickSearchConfig.operation ?? savedQuickSearchConfig?.operation;\n\nif (!$ctrl.resetConfig) {\n    $ctrl.columns?.forEach((c) => c.checked = savedColumns.includes(c.label));\n}\n\n$ctrl.columnConfig.checkedColumnCount = $ctrl.columns?.filter((c) => c.checked).length ?? 0;",
      "description": "",
      "invokeOnLoad": true,
      "isAsync": false,
      "name": "onComponentInit",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "id": "service",
      "name": "quickSearchConfigService",
      "resourceIdentity": "services/config-services/quick-search-config-service",
      "type": "service"
    },
    {
      "description": "",
      "name": "resetConfig",
      "type": "property",
      "value": "false"
    },
    {
      "id": "service",
      "name": "columnConfigService",
      "resourceIdentity": "services/config-services/column-config-service",
      "type": "service"
    }
  ]
