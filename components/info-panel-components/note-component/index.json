  "modules": [],
  "name": "note-component",
  "parentDirectoryId": "1RazoPSP8sShi8sWRi16c",
  "styles": [],
  "type": "custom-component",
  "variables": [
    {
      "description": "The current instance of the editor.",
      "name": "editor",
      "type": "property",
      "value": ""
    },
    {
      "body": "$ctrl.editor = editor;\n\nif ($ctrl.currentlyEditingNote) $ctrl.editor.root.innerHTML = $ctrl.currentlyEditingNote.body;\nelse $ctrl.editor.setContents([]);\n\nif (!$ctrl.editor.hasOwnProperty('getHTML')) {\n    $ctrl.editor.getHTML = () => {\n        return $ctrl.editor.root.innerHTML;\n    }\n}",
      "description": "Handles the initialization of the rich text editor to get the reference of editor and assign it to `$ctrl.editor`.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onEditorInit",
      "parameters": [
        "editor"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "if($ctrl.currentTextValue) {\n    if(!$ctrl.currentTextValue.trim()) return;\n\n    const newNote = $ctrl.editor.getHTML();\n\n    if (!$ctrl.currentlyEditingNote) {\n        $ctrl.notes.unshift({\n            createdOn: \"...\",\n            modifiedOn: \"...\",\n            body: newNote\n        });\n        $ctrl.scrollToTopOfChild();\n    } else $ctrl.currentlyEditingNote.body = newNote;\n\n    $ctrl.saveNote({\n        relatedEntityId: $ctrl.relatedEntityId\n    });\n\n    if ($ctrl.currentlyEditingNote) $ctrl.currentlyEditingNote = null;\n\n    $ctrl.editor.setContents([]);\n}",
      "description": "Handles the current content of the editor and append its value to the current list of `notes`.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onSaveButtonClick",
      "parameters": [
        "event"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "description": "The current content of the text editor.",
      "name": "currentTextValue",
      "type": "property",
      "value": ""
    },
    {
      "body": "if ($ctrl.notes) {\n    const noteToEdit = $ctrl.notes.find(note => note.activityId === activityId);\n    const noteBody = noteToEdit?.body;\n    if (!noteBody.trim()) return;\n\n    noteToEdit.isEditingThisNote = true;\n    $ctrl.currentlyEditingNote = noteToEdit;\n    $ctrl.editor.root.innerHTML = noteBody;\n\n    // scrollToTopOfChild();\n}\n\nfunction scrollToTopOfChild() {\n  const childScrollableElement = document.querySelector('div[bln-panel-content]');\n  if (childScrollableElement) {\n    // childScrollableElement.scrollTop = 0;\n    childScrollableElement.scrollTo({ top: 0, behavior: 'smooth' });\n  }\n}",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onEditButtonClick",
      "parameters": [
        "activityId"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "description": "",
      "name": "currentlyEditingNote",
      "type": "property",
      "value": ""
    },
    {
      "body": "if ($ctrl.notes) {\n    $ctrl.currentlyEditingNote.isEditingThisNote = false;\n    $ctrl.currentlyEditingNote = null;\n    $ctrl.editor.setContents([]);\n}",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onCancelEditButtonClick",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "description": "",
      "name": "filterTarget",
      "type": "property",
      "value": ""
    },
    {
      "body": "if ($ctrl.editor) {\n    $ctrl.currentlyEditingNote = null;\n    $ctrl.editor.setContents([]);\n}",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "watchFilterTarget",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": [
        "$ctrl.filterTarget"
      ]
    },
    {
      "body": "if ($ctrl.currentlyEditingNote) {\n    $ctrl.onCancelEditButtonClick();\n    return;\n}\n\n$ctrl.isAddingNote = !$ctrl.isAddingNote",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onAddButtonClick",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "description": "",
      "name": "isAddingNote",
      "type": "property",
      "value": ""
    },
    {
      "body": "const childScrollableElement = document.querySelector('div[bln-panel-content]');\nif (childScrollableElement) {\n  childScrollableElement.scrollTo({ top: 0, behavior: 'smooth' });\n}",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "scrollToTopOfChild",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    }
  ]
}
