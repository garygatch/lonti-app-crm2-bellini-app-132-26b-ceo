      "body": "if ($ctrl.calls) {\n    const callToEdit = $ctrl.calls.find(call => call.activityId === activityId);\n    $ctrl.utilityService.populateForm($ctrl.callForm, callToEdit);\n    callToEdit.isEditingThisCall = true;\n    $ctrl.isEditingCall = true;\n    $ctrl.isViewingCall = true;\n}",
