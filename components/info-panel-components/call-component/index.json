    {
      "body": "if ($ctrl.isAddingCall) $ctrl.isAddingCall = false;\nelse {\n    $ctrl.isEditingCall = false;\n    const callToEdit = $ctrl.calls.find(call => call.activityId === $ctrl.currentCallLogId);\n    callToEdit.isEditingThisCall = false;\n    $ctrl.utilityService.clearForm($ctrl.callForm);\n}",
