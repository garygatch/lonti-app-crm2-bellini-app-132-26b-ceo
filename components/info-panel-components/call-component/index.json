      "type": "property",
      "value": ""
    },
    {
      "body": "$ctrl.editor = editor;\n\nif ($ctrl.currentlyEditingNote) $ctrl.editor.root.innerHTML = $ctrl.currentlyEditingNote.body;\nelse $ctrl.editor.setContents([]);\n\nif (!$ctrl.editor.hasOwnProperty('getHTML')) {\n    $ctrl.editor.getHTML = () => {\n        return $ctrl.editor.root.innerHTML;\n    }\n}",
      "description": "Handles the initialization of the rich text editor to get the reference of editor and assign it to `$ctrl.editor`.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onEditorInit",
      "parameters": [
        "editor"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "if (hasNonEmptyValues($ctrl.callForm)) {\n    if (!$ctrl.isEditingCall) {\n        let newNote = $ctrl.callForm.body;\n\n        if ($ctrl.editor && newNote) {\n            newNote = $ctrl.editor.getHTML();\n        }\n\n        $ctrl.calls.unshift({\n            ...$ctrl.callForm,\n            createdOn: \"...\",\n            modifiedOn: \"...\",\n        });\n\n        if (newNote) {\n            $ctrl.notes.unshift({\n                createdOn: \"...\",\n                modifiedOn: \"...\",\n                body: newNote\n            });\n        }\n\n        $ctrl.scrollToTopOfChild();\n    } else {\n        const callToEdit = $ctrl.calls.find(call => call.isEditingThisCall);\n        Object.keys($ctrl.callForm).forEach(key => callToEdit[key] = $ctrl.callForm[key]);\n        const { isEditingThisCall, ...callToEditWithoutIsEditingThisCall } = callToEdit;\n        $ctrl.currentCallLog = $ctrl.utilityService.formatEntityForDisplay(callToEditWithoutIsEditingThisCall);\n    }\n\n    $ctrl.saveCall();\n\n    if ($ctrl.isAddingCall) $ctrl.isAddingCall = false;\n\n    if ($ctrl.isEditingCall) $ctrl.isEditingCall = false;\n\n    $ctrl.utilityService.clearForm($ctrl.callForm);\n\n    if ($ctrl.editor) $ctrl.editor.setContents([]);\n}\n\nfunction hasNonEmptyValues(obj) {\n    for (const key in obj) {\n        if (obj.hasOwnProperty(key)) {\n            const value = obj[key];\n            if (value !== null && value !== undefined && value !== \"\") {\n                return true;\n            }\n        }\n    }\n    return false;\n}",
      "description": "Handles the current content of the editor and append its value to the current list of `notes`.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onSaveButtonClick",
      "parameters": [
