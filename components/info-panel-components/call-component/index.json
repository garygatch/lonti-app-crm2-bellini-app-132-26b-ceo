      "watch": []
    },
    {
      "body": "if (!row) {\n    $ctrl.isViewingCall = false;\n    $ctrl.isViewingCallNotes = false;\n    $ctrl.isEditingCall = false;\n    $ctrl.currentCallLog = undefined;\n    $ctrl.notes.length = 0;\n    return;\n}\n\n$ctrl.currentCallLog = $ctrl.utilityService.formatEntityForDisplay(row);\n$ctrl.currentCallLogId = row.activityId;\n$ctrl.isViewingCall = true;",
