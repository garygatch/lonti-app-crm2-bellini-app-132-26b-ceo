      "body": "const deleteConfirmed = await $ctrl.deleteCall({\n    activityId: $ctrl.currentCallLogId\n});\n\nif (deleteConfirmed) {\n    $ctrl.currentCallLog = undefined;\n    $ctrl.currentCallLogId = undefined;\n    $ctrl.isViewingCall = false;\n    $ctrl.isViewingCallNotes = false;\n    $ctrl.isAddingCall = false;\n    $ctrl.isEditingCall = false;\n    $ctrl.utilityService.clearForm($ctrl.callForm);\n}",
