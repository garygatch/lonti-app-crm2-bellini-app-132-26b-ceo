      "body": "const tabItemIndex = selectedTab - 1;\nif ($ctrl.isAddingCall) $ctrl.isAddingCall = false;\n$ctrl.currentInfoPanelTab = $ctrl.tabItems[tabItemIndex].label;",
      "description": "",
      "invokeOnLoad": false,
