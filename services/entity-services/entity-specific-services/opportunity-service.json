    {
      "body": "return [\n    {\n        label: \"Deal Id\",\n        value: \"opportunityId\"\n    },\n    {\n        label: \"Name\",\n        value: \"name\"\n    },\n    {\n        label: \"Actual Close Date\",\n        value: \"actualCloseDate\"\n    },\n    {\n        label: \"Expected Close\",\n        value: \"expectedClose\"\n    },\n    {\n        label: \"Amount\",\n        value: \"amount\"\n    },\n    {\n        label: \"Currency\",\n        value: \"currency\"\n    },\n    {\n        label: \"Probability\",\n        value: \"probability\"\n    },\n    {\n        label: \"Annual Recurring Revenue\",\n        value: \"annualRecurringRevenue\"\n    },\n    {\n        label: \"Status\",\n        value: \"status\"\n    },\n    {\n        label: \"Forecast Category\",\n        value: \"forecastCategory\"\n    },\n    {\n        label: \"Last Activity Date\",\n        value: \"lastActivityDate\"\n    },\n    {\n        label: \"Next Activity Date\",\n        value: \"nextActivityDate\"\n    },\n    {\n        label: \"Description\",\n        value: \"description\"\n    },\n    {\n        label: \"Owner Name\",\n        value: \"ownerName\"\n    },\n    {\n        label: \"Owner Email\",\n        value: \"ownerEmail\"\n    },\n    ...(window.location.hash.includes(\"pipeline-management\")\n        ? []\n        : [\n            {\n                label: \"Pipeline\",\n                value: \"pipelineId\"\n            },\n            {\n                label: \"Pipeline Stage\",\n                value: \"pipelineStageId\"\n            }\n        ]\n    ),\n    {\n        label: \"Hubspot Id\",\n        value: \"hubspotId\"\n    },\n    {\n        label: \"Tenant Id\",\n        value: \"tenantId\"\n    },\n    {\n        label: \"Created On\",\n        value: \"createdOn\"\n    },\n    {\n        label: \"Modified On\",\n        value: \"modifiedOn\"\n    }\n];",
