    {
      "body": "$ctrl.entityUiStateService.currentEntityType = \"pipeline\";\n$ctrl.entityUiStateService.currentEntityTypeHasActivities = false;\n$ctrl.entityUiStateService.currentPageKey = \"pipeline-management\";\n$ctrl.entityUiStateService.currentForm = $ctrl.pipelineService.pipelineForm;\n$ctrl.entityUiStateService.currentDisplayColumnConfig = $ctrl.pipelineService.getDisplayColumnConfig();\n$ctrl.entityUiStateService.currentDefaultColumnConfig = $ctrl.pipelineService.getDefaultDisplayColumnConfig();\n$ctrl.entityUiStateService.currentFilter.columnValues = $ctrl.pipelineService.getFilterColumnValues();\n$ctrl.entityUiStateService.currentDefaultSearchConfig = $ctrl.pipelineService.getDefaultSearchConfig();\n$ctrl.entityUiStateService.initQuickSearchConfig();\n$ctrl.entityUiStateService.onPageChange(currentPage, undefined, true);",
      "description": "",
      "invokeOnLoad": true,
      "isAsync": false,
      "name": "initializePage",
      "parameters": [
        "currentPage"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
