    {
      "body": "if (!$ctrl.authService.isCurrentUserAdmin) {\n    $ctrl.$state.go(\"contact-management\");\n    return;\n}\n\n$ctrl.entityUiStateService.currentApiType = \"auth\";\n$ctrl.entityUiStateService.currentEntityType = \"user\";\n\n$ctrl.entityUiStateService.currentTabItems = [\n    {\n        label: \"Users\",\n        closable: false\n    },\n    {\n        label: \"Tenants\",\n        closable: false\n    },\n    {\n        label: \"Roles\",\n        closable: false\n    },\n    {\n        label: \"Scopes\",\n        closable: false\n    }\n];\n\n$ctrl.entityUiStateService.currentForm = $ctrl.userService.userForm;\n$ctrl.entityUiStateService.currentDisplayColumnConfig = $ctrl.userService.getDisplayColumnConfig();\n$ctrl.entityUiStateService.currentFilter.columnValues = $ctrl.userService.getFilterColumnValues();\n$ctrl.entityUiStateService.onPageChange(currentPage, undefined, true);",
