    {
      "body": "const entityServiceMap = {\n    user: $ctrl.userService,\n    tenant: $ctrl.tenantService,\n    role: $ctrl.roleService,\n    scope: $ctrl.scopeService\n};\n\nconst entityType = $ctrl.entityUiStateService.currentEntityType;\nconst uiStateService = $ctrl.entityUiStateService;\nconst targetService = entityServiceMap[entityType];\n\nif (targetService) {\n    const formPropertyName = `${entityType}Form`;\n\n    uiStateService.currentForm = targetService[formPropertyName];\n    uiStateService.currentDisplayColumnConfig = targetService.getDisplayColumnConfig();\n    uiStateService.currentFilter.columnValues = targetService.getFilterColumnValues();\n    $ctrl.entityUiStateService.onPageChange(1);\n} else {\n    console.warn(`No service configured for entity type: ${entityType}`);\n}\n\n$ctrl.currentInfoPanelTabIndex = 1;\n$ctrl.currentInfoPanelTab = \"General\";\n\n$ctrl.infoPanelTabItems = [\n    {\n        label: \"General\",\n        closable: false\n    },\n\n    // Conditionally spread the \"Roles\" object into the array\n    ...(entityType === \"user\" ? [{\n        label: \"Roles\",\n        closable: false\n    }] : []),\n\n    // Conditionally spread the \"Scopes\" object into the array\n    ...(entityType === \"role\" ? [{\n        label: \"Scopes\",\n        closable: false\n    }] : [])\n];",
