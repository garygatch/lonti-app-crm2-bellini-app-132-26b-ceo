          "type": "property",
          "value": ""
        }
      ],
      "type": "object"
    },
    {
      "description": "",
      "name": "isUploadingFile",
      "type": "property",
      "value": ""
    },
    {
      "children": [],
      "description": "",
      "name": "errors",
      "type": "array"
    },
    {
      "body": "const entityType = $ctrl.fileUploadForm.entityToImport;\nlet batchEndpoint = \"\";\nlet fileFieldName = \"\";\n\nif (entityType === \"contact\") {\n    batchEndpoint = \"/contact-batch\";\n    fileFieldName = \"contactFile\";\n} else if (entityType === \"company\") {\n    batchEndpoint = \"/company-batch\";\n    fileFieldName = \"companyFile\";\n} else {\n    $ctrl.utilityService.toast(\"Invalid entity type selected\", \"ERROR\");\n    return;\n}\n\nif (!$ctrl.fileUploadForm.fileToImport) {\n    $ctrl.utilityService.toast(\"No file selected\", \"ERROR\");\n    return;\n}\n\nconst endpoint = $ctrl.dataService.apiBaseUrl + batchEndpoint;\nconst validateOnlyEndpoint = `${endpoint}?validateOnly=true`;\nconst uploadEndpoint = `${endpoint}?validateOnly=false`;\n\nconst formData = new FormData();\nformData.append(fileFieldName, $ctrl.fileUploadForm.fileToImport);\n$ctrl.isUploadingFile = true;\n\ntry {\n    await validateFile(formData, batchEndpoint);\n    await confirmAndImport(formData, batchEndpoint);\n} catch (error) {\n    handleFileUploadError(error);\n} finally {\n    $ctrl.isUploadingFile = false;\n}\n\n\nasync function handleFetch(url, options) {\n    const response = await fetch(url, options);\n    if (!response.ok) {\n        const errData = await response.json();\n        throw errData;\n    }\n    return await response.json();\n}\n\nfunction handleFileUploadError(error) {\n    $ctrl.utilityService.toast(\"Errors found\", \"ERROR\");\n    $ctrl.errors = error.errors || [error.message || \"An error occurred during file upload.\"];\n    $ctrl.entityUiStateService.isSidePanelVisible = true;\n}\n\nasync function validateFile(formData, batchEndpoint) {\n    const endpoint = $ctrl.dataService.apiBaseUrl + batchEndpoint + \"?validateOnly=true\";\n    return handleFetch(endpoint, {\n        method: 'POST',\n        headers: $ctrl.authService.getHeaders(),\n        body: formData\n    });\n}\n\nasync function confirmAndImport(formData, batchEndpoint) {\n    try {\n        if ($ctrl.errors?.length) {\n            $ctrl.entityUiStateService.isSidePanelVisible = false;\n            $ctrl.errors.length = 0;\n        }\n\n        const modalResult = await $ctrl.$modal.open(\"confirm-action-modal\", {\n            modalHeaderTitle: \"Confirm Import\",\n            modalBodyText: \"No Errors Found. Confirm Import?\"\n        });\n\n        if (modalResult.result === \"ok\") {\n            const endpoint = $ctrl.dataService.apiBaseUrl + batchEndpoint + \"?validateOnly=false\";\n            return await handleFetch(endpoint, {\n                method: 'POST',\n                headers: $ctrl.authService.getHeaders(),\n                body: formData\n            });\n        }\n        return;\n    } finally {\n        $ctrl.isUploadingFile = false;\n    }\n}",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": true,
      "name": "uploadFile",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "id": "service",
      "name": "dataService",
      "resourceIdentity": "services/data-services/data-service",
      "type": "service"
    },
    {
      "id": "service",
      "name": "authService",
      "resourceIdentity": "services/auth-services/auth-service",
      "type": "service"
    },
    {
      "name": "$modal",
      "type": "service"
    },
    {
      "id": "service",
      "name": "utilityService",
      "resourceIdentity": "services/util-services/utility-service",
      "type": "service"
    },
    {
      "body": "if (error?.companyRecord?.name) {\n    return \"<strong>Name: </strong>\" + error.companyRecord.name;\n}\nif (error?.companyRecord?.email) {\n    return \"<strong>Email: </strong>\" + error.companyRecord.email;\n}\nif (error?.contactRecord?.fullName) {\n    return \"<strong>Name: </strong>\" + error.contactRecord.fullName;\n}\nif (error?.contactRecord?.emailaddress1) {\n    return \"<strong>Email: </strong>\" + error.contactRecord.emailaddress1;\n}\nreturn \"<strong>Record: </strong>No identifier available\";",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "getRecordIdentifier",
      "parameters": [
        "error"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    }
