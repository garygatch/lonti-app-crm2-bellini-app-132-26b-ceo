      "resourceIdentity": "services/entity-services/entity-ui-state-service",
      "type": "service"
    },
    {
      "description": "",
      "name": "fileUploadForm",
      "properties": [
        {
          "description": "",
          "name": "entityToImport",
          "type": "property",
          "value": ""
        },
        {
          "description": "",
